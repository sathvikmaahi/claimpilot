HOST=0.0.0.0
PORT=8000

# PostgreSQL — points to local Docker instance.
# When deploying to GCP Cloud SQL, update only this value.
DATABASE_URL=postgresql+asyncpg://claimpilot:claimpilot@localhost:5435/claimpilot

# Base URL of the mock Medicaid authorization API (no trailing slash)
MOCK_AUTH_API_URL=http://localhost:8000

# Timeout in seconds for calls to the Medicaid authorization API
AUTH_API_TIMEOUT=10.0

# Life Unlimited billing config — placeholder values for POC (open items 1–4 in Pipeline B spec)
BILLING_NPI=1234567890
TAX_ID=12-3456789
PAYER_ID=MOHLTH
T2016_FEE_SCHEDULE_RATE=487.68