# Application
APP_NAME=agentic-ai-server
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Server (Cloud Run injects PORT)
HOST=0.0.0.0
PORT=8080

# CORS
CORS_ORIGINS=*

# Google ADK / GenAI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=

# Session persistence (empty = in-memory; set sqlite path for production)
CONVERSATION_DATABASE_URL=
MEMORY_ENABLED=true

# ADK session backend (separate from conversation layer)
SESSION_SERVICE_URI=

# Telemetry (enabled by default; transport separate from SQL persistence)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=agentic-ai-server
TRACE_TO_CLOUD=false
OTEL_METRICS_ENABLED=false
OTEL_LOGS_ENABLED=false
TELEMETRY_CAPTURE_MESSAGE_CONTENT=false
TELEMETRY_CAPTURE_SPAN_CONTENT=false

# Operational databases (empty = skipped)
APP_DATABASE_URL=
TELEMETRY_DATABASE_URL=sqlite:///./data/telemetry.db
ANALYTICS_DATABASE_URL=

# Agent registry
AGENT_REGISTRY_PATH=agents/registry.yaml
