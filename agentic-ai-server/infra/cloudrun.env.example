# Cloud Run production environment
APP_ENV=production
LOG_LEVEL=INFO
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Secrets injected via Secret Manager → env vars
# GOOGLE_API_KEY=...

# Observability transport → Cloud Trace/Monitoring/Logging
OTEL_ENABLED=true
TRACE_TO_CLOUD=true
OTEL_METRICS_ENABLED=true
OTEL_LOGS_ENABLED=true
TELEMETRY_CAPTURE_MESSAGE_CONTENT=false
TELEMETRY_CAPTURE_SPAN_CONTENT=false

# Operational SQL persistence (Cloud SQL recommended)
TELEMETRY_DATABASE_URL=postgresql://user:pass@/telemetry?host=/cloudsql/project:region:instance
APP_DATABASE_URL=
ANALYTICS_DATABASE_URL=

# Service account needs: roles/cloudtrace.agent, roles/monitoring.metricWriter,
# roles/logging.logWriter, roles/cloudsql.client, roles/secretmanager.secretAccessor

CONVERSATION_DATABASE_URL=sqlite:///./data/conversations.db
MEMORY_ENABLED=true
CORS_ORIGINS=https://your-frontend.example.com
